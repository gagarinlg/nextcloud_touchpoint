parameters:
    level: 5
    paths:
        - lib
    excludePaths:
        # Migrations use the Doctrine DBAL schema API (Table/Column/Schema),
        # which isn't part of the OCP stub; analysing them only yields
        # unresolved-Doctrine noise, so they're excluded (standard for NC apps).
        - lib/Migration
    # Index the real, complete OCP stubs from the nextcloud/ocp dev dependency
    # so OCP\* symbols and signatures resolve accurately. OCA\CrmNotes\* comes
    # from this app's PSR-4 autoload. (The hand-rolled tests/stubs.php is only
    # the PHPUnit bootstrap and is intentionally NOT used here.)
    scanDirectories:
        - vendor/nextcloud/ocp/OCP
    # The Contacts-tab integration references events from the separate Nextcloud
    # Contacts APP (not a Composer dependency of this app); tolerate the
    # unresolved symbol rather than vendoring the Contacts app for analysis.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#OCA\\Contacts\\Event\\LoadContactsOcaApiEvent#'
