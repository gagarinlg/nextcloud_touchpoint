# Dependencies
/node_modules/
/vendor/

# Built frontend assets (generated by `make build` / `npm run build`).
# Not committed: produced at build/package time and shipped in the release
# tarball. Keeps the repo free of churning hashed chunk files.
/js/
/css/

# Packaging / deploy staging
/build/

# Build / test caches & outputs
/.phpunit.cache/
/test-results/
/e2e/screenshots/
__pycache__/
*.pyc

# Database backups / dumps (not source)
db_backup-*.bz2
db_backup-*.zip
*.sql

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# App signing key material (must never be committed)
*.key
*.csr
*.p12
appinfo/signature.json

# Review-workflow scratch (verdicts, plans) — never committed
.review-tmp/
