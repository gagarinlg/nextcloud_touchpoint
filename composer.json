{
    "name": "nextcloud/touchpoint",
    "description": "CRM-style notes for Nextcloud contacts",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "nextcloud/ocp": "dev-stable32"
    },
    "scripts": {
        "lint": "phpstan analyse --no-progress",
        "test:unit": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Touchpoint\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Touchpoint\\Tests\\": "tests/"
        }
    }
}
