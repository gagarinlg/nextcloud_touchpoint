<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>touchpoint</id>
    <name>Touchpoint</name>
    <summary>CRM-style notes attached to address book contacts</summary>
    <description><![CDATA[
Create and manage CRM-style notes for your contacts. Supports multiple note types
(Call, Meeting, Email, Task, General) with customizable categories.
Notes are linked to address book entries and provide a timeline view of interactions.

Recommended companion app: **Contacts**. The standalone Touchpoint view works on
its own, but installing the Contacts app additionally enables the in-app Notes tab
and the contacts hover-menu entry, which surface a contact's notes directly inside
Contacts. These integrations activate automatically when Contacts is present and
stay dormant when it is not.
    ]]></description>
    <version>1.1.6</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>Touchpoint Contributors</author>
    <namespace>Touchpoint</namespace>
    <category>office</category>
    <category>organization</category>
    <website>https://github.com/gagarinlg/nextcloud_notes</website>
    <bugs>https://github.com/gagarinlg/nextcloud_notes/issues</bugs>
    <repository type="git">https://github.com/gagarinlg/nextcloud_notes.git</repository>

    <screenshot>https://raw.githubusercontent.com/gagarinlg/nextcloud_notes/master/screenshots/01-all-notes.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/gagarinlg/nextcloud_notes/master/screenshots/02-embedded-contact-card.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/gagarinlg/nextcloud_notes/master/screenshots/03-contacts-app-panel.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/gagarinlg/nextcloud_notes/master/screenshots/04-add-note-in-contacts.png</screenshot>

    <dependencies>
        <php min-version="8.2" max-version="8.5" />
        <nextcloud min-version="32" max-version="34" />
    </dependencies>

    <settings>
        <admin>OCA\Touchpoint\Settings\Admin</admin>
        <admin-section>OCA\Touchpoint\Settings\AdminSection</admin-section>
    </settings>

    <navigations>
        <navigation>
            <name>Touchpoint</name>
            <route>touchpoint.page.index</route>
            <icon>app.svg</icon>
            <order>10</order>
        </navigation>
    </navigations>

    <contactsmenu>
        <provider>OCA\Touchpoint\ContactsMenu\Provider</provider>
    </contactsmenu>
</info>
